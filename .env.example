# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.
# Do not commit .env to version control.
# ==============================================================================

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_olist
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Database Dialect & Driver
# Options: postgresql+psycopg2 or sqlite:///data/processed/ecommerce_analytics.db
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password_here@localhost:5432/ecommerce_olist

# Data Storage Paths (relative to project root or absolute)
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
EXPORTS_DIR=data/exports

# Logging & Pipeline Options
LOG_LEVEL=INFO
MPLCONFIGDIR=.matplotlib_cache
